# Copy this file to .env and adjust as needed for your local machine.

ENVIRONMENT=development
DEBUG=True

# PostgreSQL connection — match what you create locally (see README)
DATABASE_URL=postgresql+psycopg2://ecommerce_user:ecommerce_pass@localhost:5432/ecommerce_db

# JWT
SECRET_KEY=dev-only-change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — the Vite dev server origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
